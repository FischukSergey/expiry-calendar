# Шаблон для ПРОДА на VPS. Не коммитить копию как .env.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Локальная разработка этот файл не читает: демо-пароли в
# deploy/local/docker-compose.local.yml.

# -----------------------------------------------------------------------------
# PostgreSQL (только hex в пароле — иначе сломается URL DATABASE_URL)
#   openssl rand -hex 20
# -----------------------------------------------------------------------------
POSTGRES_USER=duekeep
POSTGRES_DB=duekeep
POSTGRES_PASSWORD=changeme_openssl_rand_hex_20

# -----------------------------------------------------------------------------
# JWT (минимум 32 символа)
#   openssl rand -base64 48
# -----------------------------------------------------------------------------
JWT_SECRET=changeme_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=336h
# Тикер: старт + интервал. Статус по календарному дню UTC — достаточно 1–2 раза в сутки.
TICKER_EVERY=12h
# Демо-seed на проде выключен в compose (SEED=false). Не включать.

# -----------------------------------------------------------------------------
# Домен и Let's Encrypt (VPS Beget: 159.194.252.6, A duekeep.ru)
# -----------------------------------------------------------------------------
DOMAIN=duekeep.ru
LETSENCRYPT_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# Web Push (VAPID) — ключи сгенерировать один раз, хранить только в .env на VPS
#   npx web-push generate-vapid-keys --json
# VAPID_SUBJECT: email без префикса mailto: (библиотека добавит сама)
# -----------------------------------------------------------------------------
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=admin@example.com
